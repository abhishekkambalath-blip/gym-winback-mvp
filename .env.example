ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: path to the database (default gym.db)
# GYM_DB=gym.db
# Triggers (Step 6)
WEBHOOK_SECRET=
NIGHTLY_HOUR=2
NIGHTLY_LIMIT=20
RISK_THRESHOLD=50
TIMEZONE=Asia/Kolkata
# Optional: DISABLE_SCHEDULER=1 turns off the in-server nightly job (tests, local debugging, or when using cron)
# Optional: DEMO_DRAFTS=1 makes webhooks and nightly.py use template [DEMO] drafts instead of Claude
